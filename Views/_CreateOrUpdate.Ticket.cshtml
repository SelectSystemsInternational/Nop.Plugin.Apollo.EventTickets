            </div>
            <div class="col-md-9">
                <nop-editor asp-for="ProductModel.Sku" />
                <span asp-validation-for="ProductModel.Sku"></span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="ProductModel.SelectedCategoryIds" />
            </div>
            <div class="col-md-9">
                <nop-select asp-for="ProductModel.SelectedCategoryIds" asp-items="Model.ProductModel.AvailableCategories" asp-multiple="true" />
                <script>
                    $(document).ready(function () {
                        var categoryIdsInput = $('#@Html.IdFor(model => model.ProductModel.SelectedCategoryIds)').data("kendoMultiSelect");
                        categoryIdsInput.setOptions({
                            autoClose: false,
                            filter: "contains"
                        });

                    @if (Model.ProductModel.AvailableCategories.Count == 0)
                    {
                        <text>
                                categoryIdsInput.setOptions({
                                    enable: false,
                                    placeholder: '@T("Admin.Catalog.Products.Fields.Categories.NoCategoriesAvailable")'
                                });
                            categoryIdsInput._placeholder();
                            categoryIdsInput._enable();
                        </text>
                    }
                                    });
                </script>
            </div>
        </div>
        <div class="form-group row @(Model.ProductModel.ProductEditorSettingsModel.Manufacturers ? null : "advanced-setting")">
            <div class="col-md-3">
