            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="ProductTypeExtension.EventTicketReportDateTime" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="ProductTypeExtension.EventTicketReportDateTime" />
                <span asp-validation-for="ProductTypeExtension.EventTicketReportDateTime"></span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
