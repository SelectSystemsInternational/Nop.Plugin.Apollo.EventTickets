                    </div>
                </div>
            </div>))
        @if (Model.ProductModel.Id > 0 && Model.ProductModel.AssociatedToProductId > 0)
        {
            <div class="form-group row @(Model.ProductModel.ProductEditorSettingsModel.ProductType ? null : "advanced-setting")">
