            </div>
            <div class="col-md-9">
                <nop-select asp-for="ProductModel.SelectedManufacturerIds" asp-items="Model.ProductModel.AvailableManufacturers" asp-multiple="true" />
                <script>
                    $(document).ready(function () {
                        var manufacturersIdsInput = $('#@Html.IdFor(model => model.ProductModel.SelectedManufacturerIds)').data("kendoMultiSelect");
                        manufacturersIdsInput.setOptions({
                            autoClose: false,
                            filter: "contains"
                        });

                    @if (Model.ProductModel.AvailableManufacturers.Count == 0)
                    {
                        <text>
                                manufacturersIdsInput.setOptions({
                                    enable: false,
                                    placeholder: '@T("Admin.Catalog.Products.Fields.Manufacturers.NoManufacturersAvailable")'
                                });
                            manufacturersIdsInput._placeholder();
