                    <a asp-controller="Ticket" asp-action="Edit" asp-route-id="@Model.ProductModel.AssociatedToProductId">@Model.ProductModel.AssociatedToProductName</a>
                </div>
            </div>
        }
        <div class="form-group row @(Model.ProductModel.ProductEditorSettingsModel.Published ? null : "advanced-setting")">
            <div class="col-md-3">
                <nop-label asp-for="ProductModel.Published" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="ProductModel.Published" />
                <span asp-validation-for="ProductModel.Published"></span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="ProductTypeExtension.RecordStatusId" />
            </div>
            <div class="col-md-3">
                <nop-select asp-for="ProductTypeExtension.RecordStatusId" asp-items="Model.ProductTypeExtension.AvailableRecordStatus" />
                <span asp-validation-for="ProductTypeExtension.RecordStatusId"></span>
            </div>
        </div>
        <div class="form-group row @(Model.ProductModel.ProductEditorSettingsModel.Vendor ? null : "advanced-setting")" @(Model.ProductModel.IsLoggedInAsVendor ? Html.Raw("style='display: none;'") : null)>
            <div class="col-md-3">
                <nop-label asp-for="ProductModel.VendorId" />
            </div>
            <div class="col-md-9">
                <nop-select asp-for="ProductModel.VendorId" asp-items="Model.ProductModel.AvailableVendors" />
                <span asp-validation-for="ProductModel.VendorId"></span>
            </div>
        </div>
        <div class="form-group row">
