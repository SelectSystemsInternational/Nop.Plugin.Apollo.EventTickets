                        @T("Plugin.Apollo.EventTickets.AssociatedProducts.AddNew")
                    </button>
                    <input type="submit" id="btnRefreshAssociatedTickets" style="display: none" />
                    <script>
                        $(document).ready(function () {
                            $('#btnRefreshAssociatedTickets').click(function () {
                                //refresh grid
                                updateTable('#associatedproducts-grid');

                                //return false to don't reload a page
                                return false;
                            });
                        });
                    </script>
                </div>
            }
            else
            {
                <div class="card-body">
                    @T("Admin.Catalog.Products.AssociatedProducts.SaveBeforeEdit")
                </div>
            }
        </div>
        <div class="form-group row @(Model.ProductModel.ProductEditorSettingsModel.ProductTemplate ? null : "advanced-setting")" @(Model.ProductModel.AvailableProductTemplates.SelectionIsNotPossible() ? Html.Raw("style=\"display:none\"") : null) id="pnlProductTemplateId">
            <div class="col-md-3">
                <nop-label asp-for="ProductModel.ProductTemplateId" />
            </div>
            <div class="col-md-9">
                <nop-select asp-for="ProductModel.ProductTemplateId" asp-items="Model.ProductModel.AvailableProductTemplates" />
                <span asp-validation-for="ProductModel.ProductTemplateId"></span>
            </div>
        </div>
        <div class="form-group row @(Model.ProductModel.ProductEditorSettingsModel.VisibleIndividually ? null : "advanced-setting")" id="group-visible-individually">
            <div class="col-md-3">
                <nop-label asp-for="ProductModel.VisibleIndividually" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="ProductModel.VisibleIndividually" />
                <span asp-validation-for="ProductModel.VisibleIndividually"></span>
            </div>
        </div>
        <div class="form-group row @(Model.ProductModel.ProductEditorSettingsModel.Stores ? null : "advanced-setting")">
            <div class="col-md-3">
                <nop-label asp-for="ProductModel.SelectedStoreIds" />
            </div>
            <div class="col-md-9">
                <div class="row">
                    <div class="col-md-4">
                        <nop-select asp-for="ProductModel.SelectedStoreIds" asp-items="Model.ProductModel.AvailableStores" asp-multiple="true" />
                        <script>
                            $(document).ready(function () {
                                var storesIdsInput = $('#@Html.IdFor(model => model.ProductModel.SelectedStoreIds)').data("kendoMultiSelect");
                                storesIdsInput.setOptions({
                                    autoClose: false,
                                    filter: "contains"
                                });

                            @if (Model.ProductModel.AvailableStores.Count == 0)
                            {
                                <text>
                                        storesIdsInput.setOptions({
                                            enable: false,
                                            placeholder: 'No stores available'
                                        });
                                    storesIdsInput._placeholder();
                                    storesIdsInput._enable();
                                </text>
                            }
                                                    });
                        </script>
                    </div>
                    <div class="col-md-8">
                        @await Component.InvokeAsync("MultistoreDisabledWarning")
                    </div>
                </div>
            </div>
        </div>
        <div class="form-group row @(Model.ProductModel.ProductEditorSettingsModel.ACL ? null : "advanced-setting")">
            <div class="col-md-3">
                <nop-label asp-for="ProductModel.SelectedCustomerRoleIds" />
            </div>
            <div class="col-md-9">
                <div class="row">
                    <div class="col-md-4">
                        <nop-select asp-for="ProductModel.SelectedCustomerRoleIds" asp-items="Model.ProductModel.AvailableCustomerRoles" asp-multiple="true" />
                        <script>
                            $(document).ready(function () {
                                var rolesIdsInput = $('#@Html.IdFor(model => model.ProductModel.SelectedCustomerRoleIds)')
                                    .data("kendoMultiSelect");
                                rolesIdsInput.setOptions({
                                    autoClose: false,
                                    filter: "contains"
                                });

                            @if (Model.ProductModel.AvailableCustomerRoles.Count == 0)
                            {
                                <text>
                                        rolesIdsInput.setOptions({
                                            enable: false,
                                            placeholder: 'No customer roles available'
                                        });
                                    rolesIdsInput._placeholder();
                                    rolesIdsInput._enable();
                                </text>
                            }
                                                    });
                        </script>
                    </div>
                    <div class="col-md-8">
                        @await Component.InvokeAsync("AclDisabledWarning")
                    </div>
                </div>
            </div>
        </div>
        <div class="@(Model.ProductModel.ProductEditorSettingsModel.RequireOtherProductsAddedToCart ? null : "advanced-setting")" id="group-required-other-products">
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="ProductModel.RequireOtherProducts" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="ProductModel.RequireOtherProducts" />
                    <span asp-validation-for="ProductModel.RequireOtherProducts"></span>
                </div>
            </div>
            <nop-nested-setting asp-for="ProductModel.RequireOtherProducts">
                <div class="form-group row" id="pnlRequiredProductIds">
                    <div class="col-md-3">
                        <nop-label asp-for="ProductModel.RequiredProductIds" />
                        <span id="required-products-check-progress" style="display: none; float: right; clear: both" class="please-wait">
                            @T("Common.Wait...")
                        </span>
                    </div>
                    <div class="col-md-9">
                        <div class="input-group">
                            <nop-editor asp-for="ProductModel.RequiredProductIds" />
                            <span class="input-group-btn">
                                <input type="submit" id="btnRefreshRequiredProducts" style="display: none" />
                                <script>
                                    $(document).ready(function () {
                                        $('#btnRefreshRequiredProducts').click(function () {
                                            //refresh product list
                                            loadRequiredProductFriendlyNames();

                                            //return false to don't reload a page
                                            return false;
                                        });
                                    });
                                </script>
                                <button type="submit" id="btnAddNewRequiredProduct" onclick="javascript:OpenWindow('@(Url.Action("RequiredProductAddPopup", "Ticket", new {btnId = "btnRefreshRequiredProducts", productIdsInput = "RequiredProductIds"}))', 800, 850, true); return false;" class="btn btn-info">
                                    @T("Admin.Catalog.Products.Fields.RequiredProductIds.AddNew")
                                </button>
                            </span>
                        </div>
                        <span id="required-product-names"></span>
                        @Html.ValidationMessageFor(model => model.ProductModel.RequiredProductIds)
                    </div>
                </div>
                <div class="form-group row" id="pnlAutomaticallyAddRequiredProducts">
                    <div class="col-md-3">
                        <nop-label asp-for="ProductModel.AutomaticallyAddRequiredProducts" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ProductModel.AutomaticallyAddRequiredProducts" />
                        <span asp-validation-for="ProductModel.AutomaticallyAddRequiredProducts"></span>
                    </div>
                </div>
            </nop-nested-setting>
        </div>
        <div class="form-group row @(Model.ProductModel.ProductEditorSettingsModel.AllowCustomerReviews ? null : "advanced-setting")">
            <div class="col-md-3">
                <nop-label asp-for="ProductModel.AllowCustomerReviews" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="ProductModel.AllowCustomerReviews" />
                <span asp-validation-for="ProductModel.AllowCustomerReviews"></span>
            </div>
        </div>
        <div class="form-group row @(Model.ProductModel.ProductEditorSettingsModel.AdminComment ? null : "advanced-setting")">
            <div class="col-md-3">
                <nop-label asp-for="ProductModel.AdminComment" />
            </div>
            <div class="col-md-9">
                <nop-textarea asp-for="ProductModel.AdminComment" />
                <span asp-validation-for="ProductModel.AdminComment"></span>
            </div>
        </div>
    </div>
</div>