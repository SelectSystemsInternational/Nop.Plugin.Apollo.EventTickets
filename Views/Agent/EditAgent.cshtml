@model AffiliateModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    //page title
    ViewBag.PageTitle = T("Admin.Affiliates.EditAffiliateDetails").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Nop.Plugin.Apollo.EventTickets.Agents");
}

<form asp-controller="CustomAffiliate" asp-action="EditAgent" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Affiliates.EditAffiliateDetails") - @Model.Address.FirstName @Model.Address.LastName
            <small>
                <i class="fa fa-arrow-circle-left"></i>
                <a asp-action="ListAgent">@T("Admin.Affiliates.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn bg-blue">
                <i class="fa fa-floppy-o"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn bg-blue">
                <i class="fa fa-floppy-o"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            <span id="customaffiliate-delete-agent" class="btn bg-red">
                <i class="fa fa-trash-o"></i>
                @T("Admin.Common.Delete")
            </span>
            @await Component.InvokeAsync("AdminWidget", new { widgetZone = AdminWidgetZones.AffiliateDetailsButtons, additionalData = Model })
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/SSI.Apollo.EventTickets/Views/Agent/_CreateOrUpdate.Agent.cshtml", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="customaffiliate-delete-agent" />