@model TicketModel

@using Nop.Plugin.Apollo.EventTickets.Models

<div class="card-body">
    <div class="cards-group">
        @(await Html.LocalizedEditorAsync<TicketModel, TicketLocalizedModel>("product-seo-localized",
        @<div>
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="@Model.ProductModel.Locales[item].SeName" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="@Model.ProductModel.Locales[item].SeName" />
                    <span asp-validation-for="@Model.ProductModel.Locales[item].SeName"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="@Model.ProductModel.Locales[item].MetaTitle" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="@Model.ProductModel.Locales[item].MetaTitle" />
                    <span asp-validation-for="@Model.ProductModel.Locales[item].MetaTitle"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="@Model.ProductModel.Locales[item].MetaKeywords" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="@Model.ProductModel.Locales[item].MetaKeywords" />
                    <span asp-validation-for="@Model.ProductModel.Locales[item].MetaKeywords"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="@Model.ProductModel.Locales[item].MetaDescription" />
                </div>
                <div class="col-md-9">
                    <nop-textarea asp-for="@Model.ProductModel.Locales[item].MetaDescription"></nop-textarea>
                    <span asp-validation-for="@Model.ProductModel.Locales[item].MetaDescription"></span>
                </div>
            </div>
            <script>
                $(document).ready(function () {
                    $('#@Html.IdFor(model => model.ProductModel.Locales[item].SeName)').on('input change', function () {
                        var parameters = {
                            entityId: '@Model.Id',
                            entityName: 'Product',
                            seName: $(this).val()
                        };
                        warningValidation('@Url.Action("UrlReservedWarning", "Common")', '@Html.NameFor(model => model.ProductModel.Locales[item].SeName)', parameters);
                    });
                });
            </script>
            <div>
                <input type="hidden" asp-for="@Model.Locales[item].LanguageId"/>
            </div>
        </div>
        ,
        @<div>
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="ProductModel.SeName" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="ProductModel.SeName" />
                    <span asp-validation-for="ProductModel.SeName"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="ProductModel.MetaTitle" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="ProductModel.MetaTitle" />
                    <span asp-validation-for="ProductModel.MetaTitle"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="ProductModel.MetaKeywords" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="ProductModel.MetaKeywords" />
                    <span asp-validation-for="ProductModel.MetaKeywords"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="ProductModel.MetaDescription" />
                </div>
                <div class="col-md-9">
                    <nop-textarea asp-for="ProductModel.MetaDescription"></nop-textarea>
                    <span asp-validation-for="ProductModel.MetaDescription"></span>
                </div>
            </div>
            <script>
                $(document).ready(function () {
                    $('#@Html.IdFor(model => model.ProductModel.SeName)').on('input change', function () {
                        var parameters = {
                            entityId: '@Model.ProductModel.Id',
                            entityName: 'Product',
                            seName: $(this).val()
                        };
                        warningValidation('@Url.Action("UrlReservedWarning", "Common")', '@Html.NameFor(model => model.ProductModel.SeName)', parameters);
                    });
                });
            </script>
        </div>))
    </div>
</div>