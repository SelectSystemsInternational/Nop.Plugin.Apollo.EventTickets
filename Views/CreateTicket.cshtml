@model TicketModel

@using Nop.Core.Domain.Common;
@using Nop.Plugin.Apollo.EventTickets.Models
@inject AdminAreaSettings adminAreaSettings

@{
    Layout = "_AdminLayout";

    //page title
    ViewBag.PageTitle = T("Plugin.Apollo.EventTickets.CreateTicketsDetails").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Nop.Plugin.Apollo.EventTickets.CreateOrUpdateTickets");

    var defaultGridPageSize = adminAreaSettings.DefaultGridPageSize;
    var gridPageSizes = adminAreaSettings.GridPageSizes;
}

<form asp-controller="Ticket" asp-action="Create" method="post" id="product-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Catalog.Products.AddNew")
            <small>
                <i class="fa fa-arrow-circle-left"></i>
                <a asp-action="List">@T("Plugin.Apollo.EventTickets.Admin.Tickets.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn bg-blue">
                <i class="fa fa-floppy-o"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn bg-blue">
                <i class="fa fa-floppy-o"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            @await Component.InvokeAsync("AdminWidget", new { widgetZone = AdminWidgetZones.ProductDetailsButtons })
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/SSI.Apollo.EventTickets/Views/_CreateOrUpdateTickets.cshtml", Model)
</form>
@if (!Model.ProductModel.IsLoggedInAsVendor)
{
    //product editor settings modal
    @await Html.PartialAsync("_ProductEditorSettingsModal", Model.ProductModel)
}