@model TicketModel

@using Nop.Plugin.Apollo.EventTickets.Models

<div class="card-body">
    <p>
        @T("Admin.Catalog.Products.StockQuantityHistory.Hint")
    </p>
    @await Component.InvokeAsync("AdminWidget", new { widgetZone = AdminWidgetZones.ProductDetailsStockQuantityHistoryTop, additionalData = Model.ProductModel })
    @*hide the entire search block if no elements are displayed*@
<div @(Model.ProductModel.StockQuantityHistorySearchModel.AvailableWarehouses.SelectionIsNotPossible() ? Html.Raw("style=\"display:none\"") : null)>
    <div class="form-group row" @(Model.ProductModel.StockQuantityHistorySearchModel.AvailableWarehouses.SelectionIsNotPossible() ? Html.Raw("style=\"display:none\"") : null)>
        <div class="col-md-3">
            <nop-label asp-for="ProductModel.StockQuantityHistorySearchModel.WarehouseId" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="ProductModel.StockQuantityHistorySearchModel.WarehouseId" asp-items="Model.ProductModel.StockQuantityHistorySearchModel.AvailableWarehouses" />
        </div>
    </div>
    <div class="row">
        <div class="text-center col-12">
            <button type="button" id="search-stock-quantity-history" class="btn btn-primary btn-search">
                <i class="fas fa-search"></i>
                @T("Admin.Common.Search")
            </button>
        </div>
    </div>
</div>
   @await Html.PartialAsync("Table", new DataTablesModel
   {
       Name = "stock-quantity-history-grid",
       UrlRead = new DataUrl("StockQuantityHistory", "Ticket", new RouteValueDictionary { [nameof(Model.ProductModel.StockQuantityHistorySearchModel.ProductId)] = Model.ProductModel.StockQuantityHistorySearchModel.ProductId }),
       SearchButtonId = "search-stock-quantity-history",
       Length = Model.ProductModel.StockQuantityHistorySearchModel.PageSize,
       LengthMenu = Model.ProductModel.StockQuantityHistorySearchModel.AvailablePageSizes,
       Filters = new List<FilterParameter>
            {
                new FilterParameter(nameof(StockQuantityHistorySearchModel.WarehouseId), nameof(StockQuantityHistorySearchModel))
            },
       ColumnCollection = new List<ColumnProperty>
            {
                new ColumnProperty(nameof(StockQuantityHistoryModel.WarehouseName))
                {
                    Title = T("Admin.Catalog.Products.StockQuantityHistory.Fields.Warehouse").Text,
                    Width = "150"
                },
                new ColumnProperty(nameof(StockQuantityHistoryModel.AttributeCombination))
                {
                    Title = T("Admin.Catalog.Products.StockQuantityHistory.Fields.Combination").Text,
                    Width = "180",
                    Encode = false
                },
                new ColumnProperty(nameof(StockQuantityHistoryModel.QuantityAdjustment))
                {
                    Title = T("Admin.Catalog.Products.StockQuantityHistory.Fields.QuantityAdjustment").Text,
                    Width = "150",
                    Render = new RenderCustom("renderStockQuantityHistoryQuantityAdjustment")
                },
                new ColumnProperty(nameof(StockQuantityHistoryModel.StockQuantity))
                {
                    Title = T("Admin.Catalog.Products.StockQuantityHistory.Fields.StockQuantity").Text,
                    Width = "130"
                },
                new ColumnProperty(nameof(StockQuantityHistoryModel.Message))
                {
                    Title = T("Admin.Catalog.Products.StockQuantityHistory.Fields.Message").Text
                },
                new ColumnProperty(nameof(StockQuantityHistoryModel.CreatedOn))
                {
                    Title = T("Admin.Catalog.Products.StockQuantityHistory.Fields.CreatedOn").Text,
                    Width = "170",
                    Render = new RenderDate()
                }
            }
   })
    <script>
        function renderStockQuantityHistoryQuantityAdjustment(data, type, row, meta) {
            return (data > 0 ? '+' : '') + data;
        }
    </script>
    @await Component.InvokeAsync("AdminWidget", new { widgetZone = AdminWidgetZones.ProductDetailsStockQuantityHistoryBottom, additionalData = Model.ProductModel })
</div>